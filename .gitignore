# ---------------------------------------------------------------------------
# XBlast TNT - ignore rules
#
# Only generated files are ignored: build products, autotools output and
# packaging artefacts.  Sources, game data (image/, level/, sounds/),
# translations (*.po, *.pot) and the autotools input files (configure.in,
# Makefile.am, po/Makefile.in.in, m4/*.m4) stay under version control.
# ---------------------------------------------------------------------------

# --- Compiled objects and libraries ---------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.gcda
*.gcno
*.gcov

# --- Built programs -------------------------------------------------------
# Produced by the in-tree autotools build and by build-appimage.sh.
/xblast
/xbsndsrv
*.AppImage
*.AppImage.zsync
/AppDir/
*.AppDir/

# --- Autotools output -----------------------------------------------------
# All of these are regenerated by ./autogen.sh; remove the corresponding
# lines if you prefer to ship a pre-configured tree instead.
.deps/
autom4te.cache/
aclocal.m4
compile
configure
config.h
config.h.in
config.cache
config.log
config.status
stamp-h1
Makefile
Makefile.in
po/POTFILES
po/stamp-po
po/*.gmo
po/*.mo

# --- Build and packaging output -------------------------------------------
/build/
/dist/
*.log

# Temporary files written to the source root by packaging/windows/makewxs.sh.
/tmp
/tmp2

# --- Distribution archives ------------------------------------------------
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
*.zip
*.deb
*.rpm

# --- Editor, OS and miscellaneous files -----------------------------------
*~
*.swp
*.swo
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db
.vscode/
.idea/
tags
TAGS
cscope.out
core
core.[0-9]*
