WINDIR = packaging/windows

CC ?= gcc.exe
WINDRES ?= windres
CFLAGS=-Isrc -g -O2 -fcommon -Wall -pedantic -idirafter "C:\cygnus\cygwin-b20\w32api-1.3-2\include" -DXBLASTDIR=\".\" -DW32 -DYYTEXT_POINTER=1 -DYYTEXT_POINTER=1 -DPACKAGE=\"xblast\" -DHAVE_LIBICE=1 -DHAVE_LIBX11=0 -DHAVE_LIBM=1 -DHAVE_LIBPNG=1 -DHAVE_DIRENT_H=1 -DSTDC_HEADERS=1 -DHAVE_SYS_WAIT_H=1 -DHAVE_FCNTL_H=1 -DHAVE_LIMITS_H=1 -DHAVE_SYS_IOCTL_H=1 -DHAVE_SYS_TIME_H=1 -DHAVE_UNISTD_H=1 -DTIME_WITH_SYS_TIME=1 -DRETSIGTYPE=void -DHAVE_STRFTIME=1 -DHAVE_VPRINTF=1 -DHAVE_GETTIMEOFDAY=1 -DHAVE_MKDIR=1 -DHAVE_SELECT=1 -DHAVE_SOCKET=1 -DHAVE_STRSTR=1 #-DMINI_XBLAST -DSMPF
LOADLIBES=-lwinmm -luser32 -lgdi32 -lwsock32 -lws2_32 
LDFLAGS=-g

OBJS_W32= src/xblast.o src/util.o src/str_util.o src/intro.o src/introdat.o src/map.o src/sprite.o \
	src/color.o src/status.o src/player.o src/bot.o src/bomb.o src/action.o src/event.o src/image.o src/shrink.o \
	src/func.o src/info.o src/ini_file.o src/atom.o src/scramble.o src/demo.o src/debug.o src/level.o \
	src/random.o src/game_local.o src/game_demo.o src/game_server.o src/game_client.o src/game.o \
	src/menu.o src/menu_player.o src/menu_level.o src/menu_control.o src/menu_game.o \
	src/menu_network.o src/menu_extras.o src/mi_tool.o src/mi_base.o src/mi_button.o \
	src/mi_color.o src/mi_combo.o src/mi_cyclic.o src/mi_host.o src/mi_int.o src/mi_keysym.o \
	src/mi_label.o src/mi_player.o src/mi_string.o src/mi_tag.o src/mi_toggle.o src/mi_map.o \
	src/mi_stat.o src/client.o src/server.o src/central.o src/network.o src/com.o src/browse.o src/com_to_server.o \
	src/com_listen.o src/com_to_client.o src/com_newgame.o src/com_stream.o src/com_dg_client.o  \
	src/com_to_central.o src/com_from_central.o src/com_central.o src/user.o src/dat_rating.o \
	src/com_dg_server.o src/com_dgram.o src/com_query.o src/com_browse.o src/com_reply.o \
	src/com_base.o src/net_socket.o src/net_tele.o src/net_dgram.o src/cfg_main.o src/cfg_level.o \
	src/cfg_player.o src/cfg_game.o src/cfg_control.o src/cfg_stat.o src/cfg_demo.o \
	src/cfg_xblast.o \
	src/w32_init.o src/w32_event.o src/w32_common.o src/w32_pixmap.o src/w32_image.o \
	src/w32_text.o src/w32_tile.o src/w32_sprite.o src/w32_atom.o src/w32_config.o \
	src/w32_keysym.o src/w32_sound.o src/w32_sndsrv.o src/w32_msgbox.o src/w32_joystick.o src/w32_socket.o \
	$(WINDIR)/xblast.coff

xblast:	$(OBJS_W32)
	$(CC) $(LDFLAGS) -o $@ $^ $(LOADLIBES)

$(WINDIR)/xblast.coff: $(WINDIR)/xblast.rc
	$(WINDRES) -I $(WINDIR) -i $(WINDIR)/xblast.rc -o $(WINDIR)/xblast.coff

clean: 
	rm -f $(OBJS_W32)
#
# end of file makefile
